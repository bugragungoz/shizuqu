<?xml version="1.0" encoding="utf-8"?>
<!-- Geist (SIL OFL 1.1, see assets/licenses): 400, with 600 for bold text.
     Static instances of the Geist variable font, so the weights also apply on Android 7. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/geist_w400"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/geist_w400"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/geist_w600"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/geist_w600"
        app:fontStyle="normal"
        app:fontWeight="600" />
</font-family>
