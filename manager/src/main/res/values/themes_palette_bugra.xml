<?xml version="1.0" encoding="utf-8"?>
<!--
  The "Bugra" palette (default): dark-first, warm black grounds, one accent (Android green).
  Values come from the Bugra design system (tokens.json) through its Material 3 role mapping:
    background, surface      -> bg            surfaceContainer      -> surface
    surfaceContainerHigh     -> surface-2     onSurface             -> ink
    onSurfaceVariant         -> muted         outlineVariant        -> line (opaque)
    outline                  -> border-control
    primary                  -> accent (dark) / accent-ink (light, so text and outlines reach 4.5:1)
    onPrimary                -> on-accent     primaryContainer      -> accent-quiet / accent fill
    error                    -> warn          tertiary              -> info
  Secondary roles are warm neutrals, so the accent stays the only chromatic color.
-->
<resources>

    <style name="ThemeOverlay.Palette.Bugra.Dark" parent="">
        <item name="colorPrimary">#FF3DDC84</item>
        <item name="colorOnPrimary">#FF131110</item>
